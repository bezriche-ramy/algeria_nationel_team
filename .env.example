# Algeria National Team - Environment Variables
# Copy to .env.local and fill values.

VITE_APP_TITLE="Les Fennecs"
VITE_APP_VERSION="2.0.0"

# API-Football (recommended primary source)
# https://www.api-football.com/
VITE_API_FOOTBALL_KEY=your_api_football_key
# Optional override if you already know the Algeria national team id on API-Football
# VITE_API_FOOTBALL_TEAM_ID=2289

# News API (recommended primary source)
# https://newsapi.org/
VITE_NEWS_API_KEY=your_newsapi_key
# Optional language code for NewsAPI query
# VITE_NEWS_API_LANGUAGE=en

# Optional SportsDB team id fallback (default: Algeria national team)
# VITE_SPORTSDB_TEAM_ID=133783

# Debug / cache control
# VITE_DISABLE_API_CACHE=false
